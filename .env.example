# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cloudinary ----
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Razorpay ----
# Dashboard → Account & Settings → API Keys → Generate Test Key.
# Test keys start with rzp_test_, live keys with rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Account & Settings → Webhooks → Add New Webhook.
# You invent this value; paste the same string in both places.
RAZORPAY_WEBHOOK_SECRET=

# ---- App ----
# Used to build the webhook URL shown in /admin/payments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
