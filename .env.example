# Copy to .env.local and fill in. .env.local is gitignored — never commit real keys.

# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cloudinary (legacy) ----
# The npm package is gone; media now lives in R2 and is served by ImageKit.
# Only the cloud name remains, and only so scripts/migrate-media-to-r2.mjs can
# still reach the old assets. Safe to delete once you retire the account.
CLOUDINARY_CLOUD_NAME=

# ---- Razorpay ----
# Dashboard → Account & Settings → API Keys → Generate Test Key.
# Test keys start with rzp_test_, live keys with rzp_live_.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Account & Settings → Webhooks → Add New Webhook.
# You invent this value; paste the same string in both places.
RAZORPAY_WEBHOOK_SECRET=

# ---- App ----
# Used to build the webhook URL shown in /admin/payments.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- ImageKit (media delivery) ----
# Setting the URL endpoint is what switches delivery over to ImageKit.
# Full setup walkthrough: SETUP_R2_IMAGEKIT.md
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# ---- Cloudflare R2 (media storage) ----
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# The bucket's public r2.dev URL — ImageKit's origin, and the migration script's
# fallback when ImageKit is not configured yet.
R2_PUBLIC_URL=

# Public bucket URL, browser-visible. Video is served straight from R2
# rather than ImageKit (ImageKit meters video separately and the free
# allowance runs out) — see videoUrl() in src/lib/media.ts.
NEXT_PUBLIC_R2_PUBLIC_URL=
